# ------------------------------------------------------------
# crafty.alakx.com
# ------------------------------------------------------------

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $scheme $hsts_header {
  https "max-age=63072000; preload";
}

server {
  set $forward_scheme https;
  set $server         "10.0.50.70";
  set $port           8443;

  listen 80;
  listen [::]:80;

  server_name crafty.alakx.com;
  access_log /var/log/angie/crafty.alakx.com.access.log proxy;
  error_log /var/log/angie/crafty.alakx.com.error.log warn;

  proxy_redirect off;
  proxy_ssl_verify off;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_buffering off;
  client_max_body_size 0;
  proxy_connect_timeout  3600s;
  proxy_read_timeout  3600s;
  proxy_send_timeout  3600s;
  send_timeout  3600s;

  include conf/http.d/include/cloudflare.conf;

  location / {
    include conf/http.d/include/proxy.conf;
  }

  status_zone $host zone=host_zone:10;
}
