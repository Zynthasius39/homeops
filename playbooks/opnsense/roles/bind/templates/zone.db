{% set ns_primary = zone.ns_primary if zone.ns_primary is defined else 'ns1.' ~ zone.name %}
$ORIGIN {{ zone.name }}.
$TTL 86400
@   IN  SOA  {{ ns_primary }}. {{ zone.admin_email if zone.admin_email is defined else 'admin.' ~ zone.name }}. (
             {{ ansible_facts.date_time.epoch }} ; serial
             21600 ; refresh (6 hours)
             3600 ; retry (1 hour)
             3542400 ; expire (5 weeks 6 days)
             3600 ; minimum (1 hour)
             )
    IN  NS   {{ ns_primary }}.
{{ ns_primary }}. IN  A  {{ zone.ns_ip if zone.ns_ip is defined else ansible_host }}

$TTL 3600
{% if zone.records is defined %}
  {% for r in zone.records %}
{% if r.name is defined %}{{ r.name }}{% endif %}    IN  {{ r.type }}  {{ r.address }}
  {% endfor %}
{% endif %}
